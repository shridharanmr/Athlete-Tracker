# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/athlete_tracker_v2

# JWT — Access token (short-lived)
JWT_SECRET=your_access_token_secret_change_in_production
JWT_EXPIRE=15m

# JWT — Refresh token (long-lived)
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRE=7d

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@athletetracker.com
FROM_NAME=Athlete Tracker

# File Upload
MAX_FILE_SIZE=5000000
